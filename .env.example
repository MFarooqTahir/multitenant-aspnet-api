# Copy this file to `.env` and adjust the values before running `docker compose up`.
# `.env` is git-ignored; `.env.example` is committed as documentation.

# PostgreSQL container
POSTGRES_DB=multitenantDb
POSTGRES_USER=multitenant-DbUser
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_PORT=5432

# API
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development

# HMAC key for JWT signing. Must be at least 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SIGNING_KEY=replace-with-a-random-32-plus-character-signing-key

# Password given to the two seeded demo tenants (acme, globex).
DEMO_PASSWORD=Demo123!Passw0rd
