# Copy this file to `.env` and adjust the values before running `docker compose up`.
# `.env` is git-ignored; `.env.example` is committed as documentation.
#
# The defaults below are local development conveniences only. Change them (and the
# matching connection string in appsettings.Development.json) for anything shared.

# PostgreSQL container
POSTGRES_DB=multitenantDb
POSTGRES_USER=multitenant-DbUser
# Must match the Password in the ConnectionStrings:Postgres used by `dotnet run`
# (see the sample in README "Configuration").
POSTGRES_PASSWORD=multitenant-DbPassword123!
POSTGRES_PORT=5432

# API
API_PORT=8080
# Production keeps exception detail out of error responses even in the demo stack.
# Set to Development if you prefer readable console logs over JSON.
ASPNETCORE_ENVIRONMENT=Production

# HMAC key for JWT signing. Must be at least 32 characters. Required by compose for
# every command, including `docker compose up -d postgres`.
# Generate one with: openssl rand -base64 48
JWT_SIGNING_KEY=replace-with-a-random-32-plus-character-signing-key

# Demo seeding is opt-in: `docker compose -f compose.yaml -f compose.demo.yaml up`
# enables it with the password below. The API fails at startup if seeding is
# enabled without a password, and the default stack never seeds known accounts.
SEED_DEMO_DATA=false
DEMO_PASSWORD=Demo123!Passw0rd
