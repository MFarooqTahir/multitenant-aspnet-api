# Copy this file to `.env` and adjust the values before running `docker compose up`.
# `.env` is git-ignored; `.env.example` is committed as documentation.

# PostgreSQL container
POSTGRES_DB=multitenantDb
POSTGRES_USER=multitenant-DbUser
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_PORT=5432

# API
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development

# HMAC key for JWT signing. Must be at least 32 characters. Required by compose for
# every command, including `docker compose up -d postgres`.
# Generate one with: openssl rand -base64 48
JWT_SIGNING_KEY=replace-with-a-random-32-plus-character-signing-key

# Demo seeding is opt-in. Set SEED_DEMO_DATA=true and choose DEMO_PASSWORD to create the
# acme/globex demo tenants; the API fails at startup if seeding is enabled without a password.
SEED_DEMO_DATA=false
DEMO_PASSWORD=change-me-in-production
