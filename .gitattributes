# Normalize text files to LF in the repository so Windows and Linux contributors
# do not fight over line endings. Executable Windows scripts keep CRLF.
* text=auto eol=lf

*.sln text eol=crlf
*.slnx text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.zip binary
