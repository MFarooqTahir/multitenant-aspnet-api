<Project>
  <!--
    Central Package Management (CPM): every NuGet version lives here, and projects
    reference packages without a Version attribute. Bump a package once and every
    project that uses it moves together, so the API, infrastructure and tests can
    never drift onto different patch levels.

    Rule: add a <PackageVersion> here before adding a <PackageReference> to a
    project; the build fails with NU1010 if the version is missing.

    Stable-only policy: no -preview/-rc/-alpha packages. The application and data stack
    both target .NET 11 GA. The only remaining 10.x pin is the Microsoft.OpenApi 2-based
    Asp.Versioning.OpenApi integration; see ADR 0014 for the data-stack upgrade and ADR 0013
    for the remaining OpenAPI gate.

    The nine Microsoft.Extensions.* assemblies now in the net11.0 shared
    framework (DependencyInjection.Abstractions, Logging.Abstractions, Options,
    ...) must not be referenced directly: that raises NU1510.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!-- Keep the coupled data-stack packages on one version. -->
    <DataStackVersion>11.0.0</DataStackVersion>
    <NpgsqlVersion>11.0.0</NpgsqlVersion>
    <OpenApiVersion>11.0.0</OpenApiVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Asp.Versioning.Mvc" Version="10.2.1" />
    <PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1" />
    <PackageVersion Include="Asp.Versioning.OpenApi" Version="10.2.3" />
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageVersion Include="MailKit" Version="4.18.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="$(DataStackVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="$(OpenApiVersion)" />
    <!-- Roslyn 5.9.0's released packages depend on a build-numbered analyzer
         prerelease; pin the matching stable analyzer explicitly. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(DataStackVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(DataStackVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="$(DataStackVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Stores" Version="$(DataStackVersion)" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="$(NpgsqlVersion)" />
    <PackageVersion Include="Respawn" Version="7.0.0" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.18.3" />
    <PackageVersion Include="Serilog.AspNetCore" Version="11.0.0" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageVersion Include="Serilog.Sinks.ApplicationInsights" Version="5.0.1" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
