{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "AzureMonitor": {
      "ConnectionString": ""
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Jwt": {
    "Issuer": "multitenant-aspnet-api",
    "Audience": "multitenant-aspnet-api",
    "SigningKey": "",
    "AccessTokenMinutes": 15
  },
  "Auth": {
    "SingleSessionPerUser": true,
    "RefreshTokenDays": 30,
    "PublicBaseUrl": "http://localhost:8080",
    "TwoFactorChallengeMinutes": 5
  },
  "Identity": {
    "RequireConfirmedEmail": false,
    "EnableTwoFactor": false
  },
  "Email": {
    "Provider": "Logging",
    "FromAddress": "no-reply@multitenant.local",
    "FromName": "Multitenant API",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "UseStartTls": true,
      "Username": "",
      "Password": ""
    }
  },
  "RateLimiting": {
    "Tenant": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    },
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Database": {
    "AutoMigrate": false,
    "SeedDemoData": false
  },
  "Demo": {
    "Password": ""
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
